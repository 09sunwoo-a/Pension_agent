# 공통 설정 — 어느 환경에서나 같은 값. 환경별(LLM 프로바이더·키)은 .env.<프로파일> 에 둔다.
#
# **이 파일은 선택이다.** 프로파일 파일(.env.bank 등)이 하나뿐이면 그것이 자동으로 잡히므로
# 행내 머신에서는 만들 필요가 없다. 아래 셋 중 하나가 필요할 때만 만든다:
#   · 프로파일 파일이 둘 이상이라 어느 것을 쓸지 고정해야 할 때 (PENSION_ENV)
#   · 상담 시점의 «오늘»을 고정할 때 (PENSION_TODAY)
#   · 관측(Langfuse)을 켤 때
# 파일 위치는 src/ 다(저장소 루트가 아니다). 읽는 순서·우선순위는 pension_agent/env.py 머리말.

# 이 머신의 기본 프로파일. .env.bank / .env.gateway / .env.local 중 하나의 이름.
# 프로파일 파일이 하나뿐이면 이 줄이 없어도 그것이 잡힌다. 잠깐 바꿀 때는
# `PENSION_ENV=gateway python -m ...` 처럼 실제 환경변수로 앞에 붙인다(그쪽이 이긴다).
PENSION_ENV=local

# 상담 시점의 «오늘»을 고정할 때만(리허설·재현). 비우면 실제 날짜.
# PENSION_TODAY=2026-09-03

# 관측(Langfuse). 두 키가 있어야 켜진다 — 없으면 통째로 꺼진다. 행내는 자체 호스트로.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
