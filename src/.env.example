# 이 파일을 복사해 .env 로 쓴다.   cp .env.example .env
# .env 는 gitignore 되어 있고, 실제 환경변수가 있으면 그쪽이 이긴다.

# ── LLM (필수) ───────────────────────────────────────────────
# 내부 GenAI 플랫폼(vLLM, OpenAI 호환).
#   LLM_BASE_URL : 프로젝트 콘솔 → 작업환경 탭 → GenAI 플랫폼 카드에서 확인.
#                  URL 을 그대로 넣는다 — /v1 을 붙이지 않는다.
#   LLM_API_KEY  : 같은 카드에서 발급 (sk-... 형태). kb-key 헤더에도 같은 값이 쓰인다.
#   LLM_MODEL    : 비워 두는 것이 기본. 게이트웨이가 라우팅한다.
#                  특정 신규 모델이 필요할 때만 슬러그를 적는다.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── 호출 게이트 (선택) — 429 Too Many Requests 가 나면 여기를 조인다 ──
# 브리핑 1건 = LLM 9~11 연쇄 호출, 대화 한 턴 = 최대 4바퀴 + 동시 2건.
# 429 가 계속 나면 MAX_CONCURRENCY 를 1 로 낮추고 MIN_INTERVAL 을 늘린다.
LLM_MAX_CONCURRENCY=2
LLM_MIN_INTERVAL=0.2
LLM_RETRY_ATTEMPTS=5
LLM_COOLDOWN=2
LLM_TIMEOUT=60

# x-client-user 기본값. API 로 들어온 요청은 input_value 의 x_client_user 가 이긴다.
LLM_CLIENT_USER=pension-agent

# ── 데모 고정 (선택) ─────────────────────────────────────────
# 상담 시점의 «오늘»을 고정한다. 비우면 실제 날짜를 쓴다.
