# cp .env.example .env — 어디서나 이 파일 하나. 아래 ①②③ 중 하나만 채운다.
# ENV_PATH 는 적지 않는다 — 배포 때 Jenkins 가 serving 을 넣는다. 없으면 분석계(trnn).

# ① 행내 GenAI 플랫폼 — 콘솔이 준 URL 그대로(/v1 붙이지 않음). 분석계(trnn)·서빙계(serv) 두 벌.
LLM_BASE_URL_TRNN=
LLM_BASE_URL_SERV=
LLM_API_KEY_TRNN=
LLM_API_KEY_SERV=
# 비운다 — URL 경로가 모델을 정한다. 채우면 404.
LLM_MODEL=

# ② 행내 LLM Gateway(LiteLLM) — ①과 택일. 단계 구분 없음. 여기는 LLM_MODEL 을 채운다.
# LLM_BASE_URL=http://litellm.aidc-prod.svc.cluster.local:4000
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-4-6

# ③ 사외 — Anthropic 직접 호출 (requirements-dev.txt)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# 429 가 나면 조인다 (기본 2 · 0.2)
# LLM_MAX_CONCURRENCY=1
# LLM_MIN_INTERVAL_SEC=1.0

# 상담 «오늘» 고정(리허설) / 관측(행내 자체 호스트만)
# PENSION_TODAY=2026-09-03
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
