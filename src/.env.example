# 설정 파일 — 어디서나 이 파일 하나다.    cp .env.example .env
# 실제 환경변수가 이 파일을 이긴다 · 무엇이 잡혔는지는 `python -m pension_agent.env`
# LLM 은 ①②③ 중 **한 구역만** 채운다(②③은 파일 끝).

# ══ ① 행내 GenAI 플랫폼 ═══════════════════════════════════════════════════════
# 콘솔이 준 URL 그대로 — `/v1` 등 접미사를 붙이지 않는다.
# 분석계(trnn)/서빙계(serv) 중 어느 것을 읽을지는 배포 때 Jenkins 가 넣는 ENV_PATH 가 정한다.
LLM_BASE_URL_TRNN=
LLM_BASE_URL_SERV=
LLM_API_KEY_TRNN=
LLM_API_KEY_SERV=
# ①에서는 **비워 둔다** — URL 경로가 곧 모델이라 채우면 404 다(llm.py 의 MODEL 주석).
LLM_MODEL=

# ── 429 호출 게이트 ───────────────────────────────────────────────────────────
# 지금 값은 /health 의 rate_gate · 왜 조이는지는 README §4(STG 는 분당 10회).

# 쿼터 버킷 분산 — 사번 뒤에 임의 접미를 붙여 한 사람의 호출을 여러 버킷으로 나눈다.
# 사번은 앞에 그대로 남으므로 감사 기록은 그대로다. **항상 켜 둔다**(0 이면 끔).
# 코드 기본값은 꺼짐이고 켜는 것은 이 파일이다(llm.py 「쿼터 버킷 분산」).
LLM_CLIENT_USER_SPREAD=5

# 아래는 코드 기본값이라 그대로면 안 적어도 된다. STG 에서는 1 · 6.5 로 조인다(README §4).
#LLM_MAX_CONCURRENCY=2
#LLM_MIN_INTERVAL_SEC=0.2
#LLM_RETRY_ATTEMPTS=5
#LLM_COOLDOWN=2
# x-client-user 기본값. API 요청은 input_value 의 x_client_user 가 이긴다.
#LLM_CLIENT_USER=pension-agent

# ══ 행내 MCP — WorkB 쪽지 발송 ═════════════════════════════════════════════════
# 셋이 다 있어야 붙는다. 하나라도 비면 쪽지를 **보내지 않고 «미연결»로 답한다**(본문은 만든다).
# 붙었는지는 /health 의 mcp · 진단은 `python -m pension_agent.mcp`.
# 행내 패키지(mcp_sdk · langchain_mcp_adapters)가 있어야 실제로 연결된다 — 사외에서는 비워 둔다.
MCP_SERVER_URL=
MCP_USER_ID=
MCP_SECRET_KEY=

# 아래는 기본값·선택이다. 서버 표는 pension_agent/mcp/servers.py.
#MCP_SERVERS=workb
#MCP_CONN_ID=                   # sybase 를 켤 때만
#MCP_TIMEOUT=20
#MCP_AUTH_TTL_SEC=600
#MCP_RETRY_ATTEMPTS=2           # 발송은 재시도하지 않는다 — 붙는 단계에만 쓴다
#MCP_RETRY_BACKOFF_SEC=1

# 쪽지 사번의 **폴백 — 채우지 않는다.** 사번은 호출이 넘긴다(x_client_user 앞 7자리 ·
# input_value 의 employee_id). 채워 두면 사번을 못 읽은 요청이 조용히 이 사람 앞으로 가고,
# 비어 있으면 «받는 사람을 알 수 없어요»로 끝난다 — 뒤엣것이 맞다(PRODUCTION_RISKS 10).
#WORKB_EMP_NO=

# ══ 관측 (Langfuse) ═══════════════════════════════════════════════════════════
# 두 키가 있어야 켜지고, 없으면 통째로 꺼진다.
# ⚠ 행내 상담 내용이 나가는 곳이다. 반드시 행내 자체 호스트를 쓴다.
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#LANGFUSE_HOST=

# 상담 시점의 «오늘»을 고정할 때만(리허설·재현). 비우면 실제 날짜.
#PENSION_TODAY=2026-09-03

# ══ ② 행내 LLM Gateway (LiteLLM · OpenAI 호환) — ①과 택일 ═════════════════════
# URL 하나다(①의 _TRNN/_SERV 는 비운다). 클러스터 내부 이름이라 배포된 컨테이너 안에서만 풀린다.
# **여기는 LLM_MODEL 을 채운다** — body 의 model 이 라우팅 키다(①과 반대).
#LLM_BASE_URL=http://litellm.aidc-prod.svc.cluster.local:4000
#LLM_API_KEY=sk-...             # 콘솔 → 작업환경 탭 → LLM Gateway 카드
#LLM_MODEL=claude-sonnet-4-6    # claude-opus-4-8(고성능) · claude-haiku-4-5(경량)

# ══ ③ 사외 개발 PC — Anthropic API 직접 ═══════════════════════════════════════
# anthropic 패키지가 필요하다(pip install anthropic). ①②의 LLM_* 는 비운다.
#LLM_PROVIDER=anthropic
#ANTHROPIC_API_KEY=sk-ant-...
#IRP_AGENT_MODEL=claude-sonnet-5
