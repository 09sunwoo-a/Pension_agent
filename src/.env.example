# 설정 파일. 쓰임이 둘이라 «필수인가»의 답도 둘이다.
#
#  ① 로컬 개발 — **선택**. LLM 설정은 `.env.<프로파일>`(.env.bank · .env.gateway · .env.local)이
#     갖고, 프로파일 파일이 하나뿐이면 그것이 자동으로 잡힌다. 아래 셋 중 하나가 필요할 때만
#     만든다: 프로파일이 둘 이상이라 고를 때 · 「오늘」을 고정할 때 · 관측을 켤 때.
#
#  ② 배포 이미지 — **필수.** Dockerfile 이 COPY 하는 것은 `.env` **하나뿐**이고
#     (`.env.bank` 같은 프로파일 파일은 이미지에 들어가지 않는다), 없으면 COPY 단계에서
#     빌드가 실패한다(refs/dockerfile.md). 그래서 **배포용 `.env` 에는 LLM 설정까지 전부**
#     넣는다 — 프로파일 파일에서 옮겨 적거나, `cat .env.bank >> .env` 로 합친다.
#
# 읽는 순서·우선순위는 pension_agent/env.py 머리말. 실제 환경변수가 있으면 그쪽이 이긴다.
# 파일 위치는 src/ 다(저장소 루트가 아니다).

# ── LLM (배포용 .env 에는 필수 — 로컬은 .env.<프로파일> 이 대신한다) ──
#   LLM_BASE_URL : 프로젝트 콘솔이 준 URL 그대로. /v1 등 경로 접미사를 붙이지 않는다.
#   LLM_API_KEY  : 같은 카드에서 발급 (sk-...). kb-key 헤더에도 같은 값이 쓰인다.
#   LLM_MODEL    : **플랫폼마다 반대다.** GenAI 플랫폼(URL 경로가 곧 모델)은 비우고,
#                  LLM Gateway(엔드포인트 하나에 여러 모델)는 채운다.
#                  왜 갈리는지는 pension_agent/llm.py 의 MODEL 상수 주석.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 이 머신의 기본 프로파일. .env.bank / .env.gateway / .env.local 중 하나의 이름.
# 프로파일 파일이 하나뿐이면 이 줄이 없어도 그것이 잡힌다. 잠깐 바꿀 때는
# `PENSION_ENV=gateway python -m ...` 처럼 실제 환경변수로 앞에 붙인다(그쪽이 이긴다).
# 배포 이미지에는 프로파일 파일이 없으므로 이 줄도 필요 없다.
# PENSION_ENV=local

# ── 호출 게이트 — 429 Too Many Requests 가 나면 여기를 조인다 ──
# 값은 /health 의 rate_gate 에서 확인할 수 있다.
# LLM_MAX_CONCURRENCY=2
# LLM_MIN_INTERVAL_SEC=0.2
# LLM_RETRY_ATTEMPTS=5
# LLM_COOLDOWN=2

# 상담 시점의 «오늘»을 고정할 때만(리허설·재현). 비우면 실제 날짜.
# PENSION_TODAY=2026-09-03

# 관측(Langfuse). 두 키가 있어야 켜진다 — 없으면 통째로 꺼진다.
# ⚠ 행내 상담 내용이 나가는 곳이다. 반드시 행내 자체 호스트를 쓴다.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
