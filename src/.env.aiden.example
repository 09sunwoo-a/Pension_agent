# aiden — 행내와 외부의 중간. Sonnet 에 닿는다.
#
# Sonnet 에 닿는 방식이 둘 중 하나다. 맞는 쪽의 주석을 풀고 다른 쪽은 지운다.
#
# (가) Anthropic 호환 게이트웨이 — Anthropic SDK 가 그대로 붙고 base_url 만 다르다.
LLM_PROVIDER=anthropic
ANTHROPIC_BASE_URL=https://<aiden-anthropic-호환-엔드포인트>
ANTHROPIC_API_KEY=<aiden-발급-키>
# IRP_AGENT_MODEL=claude-sonnet-5
#
# (나) OpenAI 호환 게이트웨이 — 행내 genai 와 같은 경로(/chat/completions)로 부른다.
# LLM_PROVIDER=genai
# LLM_BASE_URL=https://<aiden-openai-호환-엔드포인트>
# LLM_API_KEY=<aiden-발급-키>
# LLM_MODEL=<Sonnet 모델 슬러그>
