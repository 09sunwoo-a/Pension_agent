# aiden — 행내와 외부의 중간. OpenAI 호환 게이트웨이로 Sonnet 에 닿는다.
# 행내 genai 와 같은 경로(/chat/completions)라 프로바이더는 genai 그대로이고 값만 다르다.
LLM_PROVIDER=genai
LLM_BASE_URL=https://<aiden-엔드포인트>              # /v1 등 경로 접미사 없이 호스트까지
LLM_API_KEY=<aiden-발급-키>
LLM_MODEL=<Sonnet 모델 슬러그>                       # aiden 이 쓰는 이름 그대로
# LLM_TIMEOUT=60
