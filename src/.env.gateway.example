# 행내 LLM Gateway (LiteLLM · OpenAI 호환).
#     cp .env.gateway.example .env.gateway
#
# 행내 GenAI 플랫폼(.env.bank)과 **택일**이다 — 프로젝트 콘솔에서 어느 카드의 키를 받았는지로
# 갈린다. 프로파일 파일은 둘 중 하나만 둔다(둘 다 두면 PENSION_ENV 로 골라야 한다).
#
# ⚠ base_url 이 쿠버네티스 «클러스터 내부» 이름이라 개발용 컴퓨트 인스턴스에서는 이름 자체가
#   안 풀린다(refs/llm-gateway.md 가 경고하는 그것 — Name or service not known).
#   이 프로파일은 **클러스터에 배포된 컨테이너 안에서만** 선다. 사외·컴퓨트 인스턴스에서
#   미리 확인할 방법이 없다.
LLM_PROVIDER=genai
LLM_BASE_URL=http://litellm.aidc-prod.svc.cluster.local:4000
LLM_API_KEY=<콘솔 → 작업환경 탭 → LLM Gateway 카드에서 발급 (sk-...)>

# LLM_MODEL 은 **채운다** — 엔드포인트 하나에 여러 모델이 붙어 있어 body 의 model 이
#   라우팅 키다. 행내 GenAI 플랫폼(.env.bank)은 반대로 비운다.
#   왜 갈리는지는 llm.py 의 MODEL 상수 주석에 적어 두었다.
#   지원 모델: claude-sonnet-4-6(균형·기본 권장) · claude-opus-4-8(고성능) · claude-haiku-4-5(경량)
LLM_MODEL=claude-sonnet-4-6

# LLM_TIMEOUT=60

# ── 호출 게이트 — 429 가 나면 여기를 조인다(.env.bank 와 같다) ──
# LLM_MAX_CONCURRENCY=2
# LLM_MIN_INTERVAL_SEC=0.2
# LLM_RETRY_ATTEMPTS=5
# LLM_COOLDOWN=2
