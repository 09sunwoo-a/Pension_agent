# 행내 LLM Gateway (LiteLLM · OpenAI 호환). Sonnet·Opus·Haiku 에 닿는다.
#     cp .env.gateway.example .env.gateway
#
# 행내 GenAI 플랫폼(공통 .env 의 LLM_BASE_URL_TRNN/_SERV)과 **택일**이다 — 콘솔에서 어느 카드의 키를 받았는지로
# 갈린다. 프로파일 파일은 둘 중 하나만 둔다(둘 다 두면 PENSION_ENV 로 골라야 한다).
#
# 호출 경로는 genai 와 같다(/chat/completions). 그래서 프로바이더는 genai 그대로이고 값만 다르다.
LLM_PROVIDER=genai

# 콘솔 → 작업환경 탭 → LLM Gateway 카드. 두 가지 꼴로 온다:
#   http://litellm.aidc-prod.svc.cluster.local:4000   쿠버네티스 «클러스터 내부» 이름.
#       ⚠ 개발용 컴퓨트 인스턴스·사외에서는 이름 자체가 안 풀린다(Name or service not known).
#         이 값으로 두면 배포된 컨테이너 안에서만 선다 — 미리 확인할 방법이 없다.
#   https://<게이트웨이-호스트>                        클러스터 밖에서 닿는 주소가 따로 있으면 그것.
# 어느 쪽이든 /v1 등 경로 접미사는 붙이지 않는다.
LLM_BASE_URL=<콘솔이 준 URL 그대로>
LLM_API_KEY=<콘솔에서 발급 (sk-...)>

# LLM_MODEL 은 **채운다** — 엔드포인트 하나에 여러 모델이 붙어 있어 body 의 model 이
#   라우팅 키다. 행내 GenAI 플랫폼(.env)은 반대로 비운다(URL 경로가 모델을 정한다).
#   왜 갈리는지는 llm.py 의 MODEL 상수 주석에 적어 두었다.
#   claude-sonnet-4-6(균형·기본 권장) · claude-opus-4-8(고성능) · claude-haiku-4-5(경량)
LLM_MODEL=claude-sonnet-4-6

# LLM_TIMEOUT=60

# ── 호출 게이트 — 429 가 나면 여기를 조인다(.env 와 같다) ──
# LLM_MAX_CONCURRENCY=2
# LLM_MIN_INTERVAL_SEC=0.2
# LLM_RETRY_ATTEMPTS=5
# LLM_COOLDOWN=2
