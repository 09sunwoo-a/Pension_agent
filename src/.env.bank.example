# 행내(망분리) — 사내 GenAI 플랫폼(OpenAI 호환 vLLM). 표준 라이브러리만으로 호출한다.
LLM_PROVIDER=genai
LLM_BASE_URL=http://<사내-genai-엔드포인트>      # /v1 등 경로 접미사 없이 호스트까지
LLM_API_KEY=<kb-key>                           # Authorization Bearer + kb-key 헤더에 같이 쓴다
LLM_MODEL=                                     # 모델 슬러그. 비우면 게이트웨이 기본 라우팅
# LLM_TIMEOUT=60
# LLM_RETRY_ATTEMPTS=3
