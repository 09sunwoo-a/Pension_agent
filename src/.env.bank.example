# 행내(망분리) — 사내 GenAI 플랫폼(OpenAI 호환 vLLM). 표준 라이브러리만으로 호출한다.
#     cp .env.bank.example .env.bank
# 행내 머신에는 프로파일 파일을 이것 하나만 두면 자동으로 잡힌다(env.py 머리말 ③).
LLM_PROVIDER=genai
LLM_BASE_URL=https://<사내-genai-엔드포인트>     # /v1 등 경로 접미사 없이 콘솔이 준 URL 그대로
LLM_API_KEY=<kb-key>                           # Authorization Bearer + kb-key 헤더에 같이 쓴다
LLM_MODEL=                                     # 비워 둔다 — 게이트웨이가 라우팅한다.
                                               # URL 이 모델을 정하는 엔드포인트(.../gemma-4)에
                                               # 다른 슬러그를 실으면 거부당한다.
# LLM_TIMEOUT=60

# ── 호출 게이트 — 429 Too Many Requests 가 나면 여기를 조인다 ──
# 브리핑 1건 = LLM 9~11 연쇄 호출, 대화 한 턴 = 최대 4바퀴 + 동시 2건.
# 계속 나면 MAX_CONCURRENCY 를 1 로 낮추고 MIN_INTERVAL_SEC 를 늘린다.
# 값은 /health 의 rate_gate 에서 확인할 수 있다.
# LLM_MAX_CONCURRENCY=2
# LLM_MIN_INTERVAL_SEC=0.2
# LLM_RETRY_ATTEMPTS=5
# LLM_COOLDOWN=2

# x-client-user 기본값. API 로 들어온 요청은 input_value 의 x_client_user 가 이긴다.
# LLM_CLIENT_USER=pension-agent
