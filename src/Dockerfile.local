# 외부망 로컬 테스트용. 공개 Docker Hub 이미지와 PyPI 를 쓴다.
#     docker build -f Dockerfile.local -t pension-agent:local .
#     docker run --rm -p 8000:8000 pension-agent:local
# CI/CD 배포에는 쓰지 않는다 — 내부망 배포는 Dockerfile 이다.

FROM python:3.10-slim

ARG ENV_FILE_PATH
# 실행 단계. 배포 시 Jenkins 가 serving 을 넣어 주면 llm.py 가 같은 .env 안의
# LLM_BASE_URL_SERV(…/serv/…)을 읽는다. 워크스페이스(train)와 **같은 .env** 를 쓴다.
ENV ENV_PATH=$ENV_FILE_PATH

WORKDIR /custom

COPY ./requirements.txt /custom/requirements.txt
# 워크스페이스에서 쓰던 그 .env 가 그대로 들어간다(단계별 URL 두 벌이 함께 있다).
# 없으면 여기서 빌드가 실패한다(skills/genai-platform-agent-dev/refs/dockerfile.md).
COPY .env /custom/.env

RUN pip install --no-cache-dir -r /custom/requirements.txt

COPY ./main.py /custom/main.py
COPY ./pension_agent /custom/pension_agent
COPY ./session_data /custom/session_data

# 미리 만들어 둔 브리핑. 저장소에 있어서 따로 만들 것은 없고, 비어 있어도 디렉터리가
# 있으면 저장소가 켜져 런타임 저장이 동작한다.
# 배포 이미지(Dockerfile)와 같은 이유·같은 자리다 — 그쪽 주석에 설명이 있다.
RUN mkdir -p /custom/briefing_cache
COPY ./briefing_cache /custom/briefing_cache

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
