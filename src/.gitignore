# 비밀 설정 — 절대 커밋 금지 (사내 게이트웨이 URL·API 키 포함)
.env
*/.env

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/

# strategy_agent 평가 대시보드 로그
**/feedback_log.csv

# 상담 세션/대화이력.
# 지금은 **시연용 목업만** 들어 있어서 저장소에 남긴다 — scripts/seed_sessions.py 가
# 엑셀 10_상담이력을 심어두므로, 받자마자 "지난 상담이 있는 고객" 상태로 시연·테스트가
# 돌아간다. 실데이터 전환 시 아래 주석을 풀어 되돌린다: 직원 발화 원문 등 개인정보에
# 준하는 내용이 쌓이는 자리다(session_store.py 머리말).
# session_data/

# 원본 PDF·스캔본은 대외비 — 추출 결과(knowledge/data/*.json)만 버전관리
sources/

# 대화형 에이전트 평가 신고 로그 (app.py 💬 탭)
**/chat_feedback.csv

# 미리 만들어 둔 브리핑 (scripts/prebuild_briefings.py).
#
# **커밋한다.** 예전에는 막았고, 그 이유는 지금도 유효하다 — 브리핑은 LLM 이 쓴 산문이라
# 저장소에 넣으면 사람이 검토하지 않은 문장이 자산으로 굳는다. 그보다 앞서는 사정이
# 생겨서 뒤집었다: 대화형은 브리핑이 **이미 있다고 보고** 답하는데(고객 재료 도구가
# strategy_agent.propose() 를 부른다), 배포 이미지가 그것을 직접 만들면 고객당 순차
# LLM 11 회다. STG 는 분당 10 회라 **한 편이 그것만으로 한도를 넘어** 완주하지 못한다.
# 즉 미리 만들어 두지 않으면 배포본이 고객 질문에 답하지 못한다.
#
# 그래서 여는 대신 둘을 지킨다.
#   · **커밋 전에 읽는다.** 검토하지 않은 문장이 굳는 것이 원래의 걱정이었고, 커밋한다고
#     그 걱정이 사라지지 않는다. 파일이 곧 화면에 뜨는 문장이다.
#   · **LLM 없이 만든 브리핑은 애초에 저장되지 않는다.** 키 없이 돈 실행(테스트·CI)의
#     산출은 LLM 섹션이 통째로 비는데, 그게 커밋되면 «출처는 진짜인데 내용이 빈» 카드가
#     된다. agent.propose() 가 그 경우 save 를 부르지 않는다.
#
# 지우고 다시 만들면 그만인 파생물인 것은 그대로다 — 코드·데이터를 고쳤으면 지문이
# 어긋나 읽히지 않으므로 다시 만들어 커밋한다(briefing_store.py 머리말 · README).
#
# 쓰다 만 임시 파일만 막는다(save 가 통째로 쓴 뒤 옮긴다).
briefing_cache/*.tmp
